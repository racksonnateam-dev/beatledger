# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://beatledger:beatledger@127.0.0.1:54329/beatledger?schema=public"

# Required. Use a long random value in any shared environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Server-side only. Do not prefix this with NEXT_PUBLIC.
AUDIO_SERVICE_URL="http://127.0.0.1:8000"

# local now. azure is reserved for a future Blob Storage adapter.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./storage"
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_BLOB_CONTAINER="beatledger"

# 40 MB
MAX_UPLOAD_BYTES="41943040"

# Read by the Python audio service, not by the browser.
RECOGNITION_ENGINE="landmark"
RECOGNITION_API_KEY=""
RECOGNITION_API_URL=""
